  "version": "0.1.0",
  "type": "module",
  "description": "App Store, Google Play, web and social marketing images, feature graphic and icons, rendered from HTML/CSS by headless Chrome.",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "brand": "node scripts/brand.js",
    "screens": "node scripts/screens.js",
    "capture": "node scripts/capture.js",
    "render": "node scripts/render.js",
    "feature": "node scripts/feature.js",
    "icons": "node scripts/icons.js",
    "validate": "node scripts/validate.js",
    "sheet": "node scripts/sheet.js",
    "preview": "node scripts/preview.js",
    "export": "node scripts/export.js",
    "bake": "node scripts/bake.js"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/newsreader": "5.3.0",
    "@fontsource-variable/noto-sans-arabic": "5.3.0",
    "@fontsource-variable/space-grotesk": "5.3.0",
    "@fontsource/poppins": "5.3.0",
    "@fontsource/roboto": "5.3.0",
